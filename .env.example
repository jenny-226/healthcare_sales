# .env.example — 이 파일을 .env로 복사한 뒤 값을 채운다. (.env는 git 제외)
# 발급처는 readme.md 2-4 참고. 1단계(정적 웹)는 키를 브라우저에 넣지 않고, 수집 스크립트·2단계 서버만 읽는다.

# 식품안전나라(foodsafetykorea.go.kr) Open API 인증키 — 건기식 고시형(I2710)·개별인정형(I-0040) 원료 (규제 확인)
MFDS_FOODSAFETY_KEY=

# 한국수출입은행 현재환율 API 인증키 (api_fx_rates → 홈 환율 띠·원가 기준 환율)
KOREAEXIM_API_KEY=

# openFDA API 키 (api_fda_supplement_recalls → 규제 확인 FDA 리콜)
FDA_API=

# OpenAI API 키 — 개발요청서 파일 자동변환·AI 문구 변환 (2단계 서버)
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 아래는 지금 쓰지 않는 키다. 해당 기능을 붙일 때 주석을 풀고 값을 채운다.
# ---------------------------------------------------------------------------

# 공공데이터포털(data.go.kr) 인증키 — 관세청 품목별 국가별 수출입실적 (api_export_stats → 홈 수출입 카드)
# export_api=

# 공공데이터포털(data.go.kr) 인증키 — KOTRA 해외시장뉴스 (홈 규제 업데이트, 2단계). export_api와 같은 키를 써도 된다.
# DATA_GO_KR_KEY=

# UN Comtrade 구독 키 — 더 많은 품목·월별 수입 자료가 필요할 때 (comtradedeveloper.un.org). 현재는 키 없는 공개 미리보기 사용.
# UN_COMTRADE_KEY=

# OpenCorporates API 키 — 바이어 발굴 ③ 기업 등록 정보 확인
# OPENCORPORATES_API_KEY=

# Gmail 발송·답장 확인 (바이어 발굴 ⑥·⑦, 2단계 서버) — 앱 비밀번호 16자리 (myaccount.google.com/apppasswords)
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
